{
  "name": "ks-shared-web",
  "version": "1.0.0",
  "private": true,
  "description": "Keystone shared web host (ks-shared-web): serves every brokerage's KS-Portal and KS-Client web build from blob storage, chosen by host name.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@azure/storage-blob": "12.28.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
